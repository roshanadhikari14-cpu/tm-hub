{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "regions": [
    "bom1"
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{team.json,seed/**,voicepack-seed/**,node_modules/@sparticuz/chromium/bin/**,node_modules/pdfjs-dist/legacy/build/**,node_modules/pdfjs-dist/package.json,node_modules/jpeg-js/**}",
      "memory": 2048
    }
  },
  "rewrites": [
